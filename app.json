{
  "expo": {
    "name": "KYC Demo",
    "slug": "kyc-demo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "kycdemo",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bensonyu.kycdemo",
      "infoPlist": {
        "NSCameraUsageDescription": "KYC Demo 需要使用摄像头拍摄自拍照和 5 秒自拍视频，用于本地演示校验。",
        "NSMicrophoneUsageDescription": "KYC Demo 需要使用麦克风录制自拍视频音轨，用于本地演示校验。"
      }
    },
    "android": {
      "package": "com.bensonyu.kycdemo",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F2F6F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "KYC Demo 需要使用摄像头拍摄自拍照和 5 秒自拍视频，用于本地演示校验。",
          "microphonePermission": "KYC Demo 需要使用麦克风录制自拍视频音轨，用于本地演示校验。",
          "recordAudioAndroid": true
        }
      ]
    ]
  }
}
